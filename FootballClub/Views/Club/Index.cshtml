@model List<Club>
@using System.Linq

@{
    ViewData["Title"] = "Clubs";
    ViewData["ActivePage"] = "Club";
    ViewData["Breadcrumbs"] = new List<(string, string?)>
    {
        ("Dashboard", "/"),
        ("Clubs", null)
    };
}

<div class="page-header">
    <h2>Football Clubs</h2>
    <p>Browse all clubs in the HNL Supersport League</p>
</div>

<div class="card">
    <div class="card-header">
        <h3>Club List</h3>
    </div>
    <div class="card-body">
        <table class="fc-table">
            <thead>
                <tr>
                    <th>Club Name</th>
                    <th>City</th>
                    <th>Founded</th>
                    <th>Budget (€M)</th>
                    <th>Players</th>
                    <th>Staff</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var club in Model.OrderBy(c => c.Name))
                {
                    <tr>
                        <td><strong>@club.Name</strong></td>
                        <td>@club.City</td>
                        <td>@club.FoundedYear</td>
                        <td>€@club.Budget.ToString("F1")</td>
                        <td><span class="badge badge-blue">@club.Players.Count</span></td>
                        <td>@(club.StaffMembers != null && club.StaffMembers.Any() ? string.Join(", ", club.StaffMembers.Select(s => s.FullName)) : "-")</td>
                        <td><a href="/Club/Details/@club.Id" class="view-link">Details &rarr;</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
