@{
    ViewData["Title"] = "Registracija";
    ViewData["Breadcrumbs"] = new List<(string, string?)>
    {
        ("Registracija", null)
    };
}

<div class="card" style="max-width: 520px;">
    <div class="card-header"><h3>Registracija</h3></div>
    <div class="card-body">
        <div id="formAlert" class="alert" style="display:none; margin-bottom: 1rem;"></div>

        <form id="registerForm">
            <div class="form-grid">
                <label class="form-field"><span class="form-label">Korisničko ime</span>
                    <input type="text" id="username" name="username" class="form-control" required minlength="3" maxlength="256" />
                </label>
                <label class="form-field"><span class="form-label">Email</span>
                    <input type="email" id="email" name="email" class="form-control" required />
                </label>
                <label class="form-field"><span class="form-label">Lozinka</span>
                    <input type="password" id="password" name="password" class="form-control" required minlength="6" />
                    <small style="color: var(--text-muted);">Min. 6 znakova, velika i mala slova te broj.</small>
                </label>
                <label class="form-field"><span class="form-label">Potvrda lozinke</span>
                    <input type="password" id="confirmPassword" name="confirmPassword" class="form-control" required minlength="6" />
                </label>
            </div>

            <div class="form-actions">
                <button class="btn btn-primary" type="submit">Registriraj se</button>
                <a class="btn btn-outline-light" href="/Account/Login">Već imaš račun? Prijava</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('registerForm').addEventListener('submit', async function (event) {
            event.preventDefault();

            var username = document.getElementById('username').value.trim();
            var email = document.getElementById('email').value.trim();
            var password = document.getElementById('password').value;
            var confirmPassword = document.getElementById('confirmPassword').value;

            if (password !== confirmPassword) {
                Auth.showAlert('formAlert', 'Lozinke se ne podudaraju.', 'danger');
                return;
            }

            try {
                var response = await fetch('/api/auth/register', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ username: username, email: email, password: password })
                });

                if (response.ok) {
                    var data = await response.json();
                    Auth.storeSession(data);
                    window.location.href = Auth.getReturnUrl();
                } else {
                    var message = await Auth.parseErrors(response);
                    Auth.showAlert('formAlert', message, 'danger');
                }
            } catch (error) {
                Auth.showAlert('formAlert', 'Greška pri povezivanju s poslužiteljem.', 'danger');
            }
        });
    </script>
}
