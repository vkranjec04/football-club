@using FootballClub.Models
@using FootballClub.Models.Enums
@model List<Player>

@{
    ViewData["Title"] = "Tactics Board";
}

<style>
    .pitch-container {
        width: 100%;
        max-width: 800px;
        aspect-ratio: 1.6;
        background: #2e7d32;
        border: 4px solid #fff;
        border-radius: 8px;
        position: relative;
        margin: 20px auto;
        overflow: hidden;
        background-image: 
            /* Center circle */
            radial-gradient(circle, transparent 48%, rgba(255,255,255,0.7) 48%, rgba(255,255,255,0.7) 52%, transparent 52%),
            /* Halfway line */
            linear-gradient(to right, transparent 49.5%, rgba(255,255,255,0.7) 49.5%, rgba(255,255,255,0.7) 50.5%, transparent 50.5%);
    }

    .penalty-box-left {
        position: absolute;
        top: 20%;
        bottom: 20%;
        left: 0;
        width: 15%;
        border: 2px solid rgba(255,255,255,0.7);
        border-left: none;
    }

    .penalty-box-right {
        position: absolute;
        top: 20%;
        bottom: 20%;
        right: 0;
        width: 15%;
        border: 2px solid rgba(255,255,255,0.7);
        border-right: none;
    }

    .player-spot {
        position: absolute;
        width: 40px;
        height: 40px;
        background: #ffc107;
        color: #000;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        font-weight: bold;
        transform: translate(-50%, -50%);
        border: 2px solid #000;
        cursor: grab;
        box-shadow: 0 4px 6px rgba(0,0,0,0.3);
    }
    
    .player-spot span {
        position: absolute;
        top: 45px;
        width: 80px;
        text-align: center;
        color: #fff;
        font-size: 12px;
        font-weight: bold;
        text-shadow: 1px 1px 2px #000;
    }

    .bench-container {
        display: flex;
        gap: 10px;
        padding: 15px;
        background: #1a1e29;
        border-radius: 8px;
        overflow-x: auto;
        margin-top: 20px;
        width: 100%;
        max-width: 800px;
        margin-left: auto;
        margin-right: auto;
    }

    .bench-player {
        background: #2a2e39;
        color: #fff;
        padding: 8px 12px;
        border-radius: 6px;
        font-size: 14px;
        white-space: nowrap;
        cursor: grab;
        border: 1px solid #4ade80;
    }

    .tactic-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .formation-select {
        background: #1a1e29;
        color: #fff;
        padding: 10px;
        border-radius: 6px;
        border: 1px solid #334155;
    }
</style>

<div class="tactic-header">
    <h2 style="color: var(--text-dark);">Tactics Board (Dinamo Zagreb)</h2>
    <select class="formation-select" onchange="changeFormation(this.value)">
        <option value="4231">4-2-3-1</option>
        <option value="433">4-3-3</option>
        <option value="352">3-5-2</option>
    </select>
</div>

<div class="pitch-container" id="pitch">
    <div class="penalty-box-left"></div>
    <div class="penalty-box-right"></div>
    
    <!-- Hardcoded initial 4-2-3-1 positions for dynamic drag and drop visualization -->
    <div class="player-spot" style="left: 10%; top: 50%;" draggable="true" ondragstart="drag(event)" id="pos-gk">1<span>Nevistić</span></div>
    <div class="player-spot" style="left: 25%; top: 20%;" draggable="true" ondragstart="drag(event)" id="pos-lb">3<span>Ogiwara</span></div>
    <div class="player-spot" style="left: 22%; top: 40%;" draggable="true" ondragstart="drag(event)" id="pos-lcb">22<span>Ristovski</span></div>
    <div class="player-spot" style="left: 22%; top: 60%;" draggable="true" ondragstart="drag(event)" id="pos-rcb">28<span>Theophile</span></div>
    <div class="player-spot" style="left: 25%; top: 80%;" draggable="true" ondragstart="drag(event)" id="pos-rb">18<span>Gabriel</span></div>

    <div class="player-spot" style="left: 45%; top: 35%;" draggable="true" ondragstart="drag(event)" id="pos-ldm">27<span>Mišić</span></div>
    <div class="player-spot" style="left: 45%; top: 65%;" draggable="true" ondragstart="drag(event)" id="pos-rdm">25<span>Sučić</span></div>

    <div class="player-spot" style="left: 65%; top: 20%;" draggable="true" ondragstart="drag(event)" id="pos-lw">20<span>Pjaca</span></div>
    <div class="player-spot" style="left: 60%; top: 50%;" draggable="true" ondragstart="drag(event)" id="pos-cam">10<span>Baturina</span></div>
    <div class="player-spot" style="left: 65%; top: 80%;" draggable="true" ondragstart="drag(event)" id="pos-rw">77<span>Špikić</span></div>

    <div class="player-spot" style="left: 85%; top: 50%;" draggable="true" ondragstart="drag(event)" id="pos-st">9<span>Petković</span></div>
</div>

<h3 style="margin-top: 20px; color: var(--text-dark);">Available Squad</h3>
<div class="bench-container" ondrop="drop(event)" ondragover="allowDrop(event)">
    @foreach(var player in Model)
    {
        <div class="bench-player" draggable="true" ondragstart="drag(event)" id="player-@player.Id">
            @player.JerseyNumber - @player.LastName (@player.Position.ToString().Substring(0, 3))
        </div>
    }
</div>

<script>
    function allowDrop(ev) {
        ev.preventDefault();
    }

    function drag(ev) {
        ev.dataTransfer.setData("text", ev.target.id);
    }

    function drop(ev) {
        ev.preventDefault();
        var data = ev.dataTransfer.getData("text");
        var draggedEl = document.getElementById(data);
        
        // Swap or move logic here if needed. 
        // For simplicity, just append to bench if dropped there, or swap innerHTML if dropped on pitch spot.
        if(ev.target.classList.contains('player-spot') || ev.target.parentElement.classList.contains('player-spot')) {
            let targetSpot = ev.target.classList.contains('player-spot') ? ev.target : ev.target.parentElement;
            
            // Simple visual swap
            let tempContent = targetSpot.innerHTML;
            let pNum = draggedEl.innerText.split('-')[0].trim();
            let pName = draggedEl.innerText.split('-')[1].split('(')[0].trim();
            
            targetSpot.innerHTML = pNum + "<span>" + pName + "</span>";
            draggedEl.style.opacity = '0.5';
        }
    }

    function changeFormation(form) {
        // Very basic mock adaptation
        if(form === '433') {
            document.getElementById('pos-cam').style.left = '55%';
            document.getElementById('pos-cam').style.top = '50%';
        }
    }
</script>