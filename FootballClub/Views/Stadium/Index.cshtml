@model IEnumerable<FootballClub.Models.Stadium>

@{
    ViewData["Title"] = "Stadiums List";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>@ViewData["Title"]</h2>
    <a href="#" class="btn btn-primary">Create New Stadium</a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>City</th>
                    <th>Capacity</th>
                    <th>Year Built</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td class="fw-bold">@item.Name</td>
                            <td>@item.City</td>
                            <td>@item.Capacity.ToString("N0")</td>
                            <td>@item.YearBuilt</td>
                            <td class="text-center">
                                <a href="#" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <a href="#" class="btn btn-sm btn-outline-info mx-1">Details</a>
                                <a href="#" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">No stadiums available in the database.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
