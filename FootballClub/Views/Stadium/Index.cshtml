@model IEnumerable<FootballClub.Models.Stadium>

@{
    ViewData["Title"] = "Stadiums List";
    ViewData["Breadcrumbs"] = new List<(string, string?)>
    {
        ("Dashboard", "/"),
        ("Stadiums", null)
    };
}

<div class="page-header" style="display:flex; align-items:center; justify-content:space-between; gap:16px;">
    <div>
        <h2>Stadiums</h2>
        <p>Venues registered in the league database</p>
    </div>
    <a href="#" class="btn btn-primary">+ Create New Stadium</a>
</div>

<div class="card">
    <div class="card-body" style="padding:0;">
        <table class="fc-table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>City</th>
                    <th>Capacity</th>
                    <th>Year Built</th>
                    <th style="text-align:right;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td><strong>@item.Name</strong></td>
                            <td>@item.City</td>
                            <td>@item.Capacity.ToString("N0")</td>
                            <td>@item.YearBuilt</td>
                            <td>
                                <div style="display:flex; gap:8px; justify-content:flex-end;">
                                    <a href="#" class="btn btn-sm btn-outline-secondary">Edit</a>
                                    <a href="#" class="btn btn-sm btn-outline-info">Details</a>
                                    <a href="#" class="btn btn-sm btn-outline-danger">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="text-align:center; padding:2rem; color: var(--text-muted);">No stadiums available in the database.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
