@model List<Coach>

@{
    ViewData["Title"] = "Dinamo Zagreb - Staff";
    ViewData["ActivePage"] = "Coach";
    ViewData["Breadcrumbs"] = new List<(string, string?)>
    {
        ("Dashboard", "/"),
        ("Staff", null)
    };
    var currentDate = DateTime.Now;
    var currentStaff = Model.Where(c => c.ContractUntil > currentDate).ToList();
    var pastCoaches = Model.Where(c => c.ContractUntil <= currentDate).OrderByDescending(c => c.ContractUntil).ToList();
}

<div class="page-header">
    <h2>Dinamo Zagreb - Staff</h2>
    <p>Current staff and management</p>
</div>

@if (currentStaff.Any())
{
    <div class="card">
        <div class="card-header">
            <h3>Current Staff</h3>
            <span class="badge badge-green">Active</span>
        </div>
        <div class="card-body">
            <table class="fc-table">
                <thead>
                    <tr>
                        <th>Role</th>
                        <th>Name</th>
                        <th>Nationality</th>
                        <th>Contract Until</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var staff in currentStaff)
                    {
                        <tr>
                            <td><span class="badge badge-gray">@staff.Role</span></td>
                            <td><strong>@staff.FirstName @staff.LastName</strong></td>
                            <td>@staff.Nationality</td>
                            <td>@staff.ContractUntil.ToString("dd.MM.yyyy")</td>
                            <td><a href="/Coach/Details/@staff.Id" class="view-link">View &rarr;</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (pastCoaches.Any())
{
    <div class="card" style="margin-top: 20px;">
        <div class="card-header">
            <h3>Past Staff</h3>
            <span class="badge badge-gray">@pastCoaches.Count</span>
        </div>
        <div class="card-body">
            <table class="fc-table">
                <thead>
                    <tr>
                        <th>Role</th>
                        <th>Name</th>
                        <th>Nationality</th>
                        <th>Contract Ended</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var coach in pastCoaches)
                    {
                        <tr>
                            <td><span class="badge badge-gray">@coach.Role</span></td>
                            <td><strong>@coach.FirstName @coach.LastName</strong></td>
                            <td>@coach.Nationality</td>
                            <td>@coach.ContractUntil.ToString("dd.MM.yyyy")</td>
                            <td><a href="/Coach/Details/@coach.Id" class="view-link">View &rarr;</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (!Model.Any())
{
    <div class="card" style="text-align: center; padding: 40px;">
        <p style="color: var(--text-muted);">No staff found</p>
    </div>
}
