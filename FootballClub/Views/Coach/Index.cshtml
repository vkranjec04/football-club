@model List<Coach>

@{
    ViewData["Title"] = "Coaches";
    ViewData["ActivePage"] = "Coach";
    ViewData["Breadcrumbs"] = new List<(string, string?)>
    {
        ("Dashboard", "/"),
        ("Coaches", null)
    };
}

<div class="page-header">
    <h2>Coaches</h2>
    <p>Browse all head coaches in the league</p>
</div>

<div class="card">
    <div class="card-header">
        <h3>Coach List</h3>
    </div>
    <div class="card-body">
        <table class="fc-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Nationality</th>
                    <th>Date of Birth</th>
                    <th>Club</th>
                    <th>Contract Until</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var coach in Model.OrderBy(c => c.LastName))
                {
                    <tr>
                        <td><strong>@coach.FirstName @coach.LastName</strong></td>
                        <td>@coach.Nationality</td>
                        <td>@coach.DateOfBirth.ToString("dd.MM.yyyy")</td>
                        <td>
                            @{
                                var club = Model.AsEnumerable().FirstOrDefault(c => c.Id == coach.Id) as Coach;
                                // We need to find which club this coach belongs to
                                // Since Coach doesn't have a Club reference, we need to check from another angle
                                // Let's just display their connection through the mock data
                                <text>-</text>
                            }
                        </td>
                        <td>@coach.ContractUntil.ToString("dd.MM.yyyy")</td>
                        <td><a href="/Coach/@coach.Id" class="view-link">Details →</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
