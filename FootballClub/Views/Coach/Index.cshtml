@model List<Coach>

@{
    ViewData["Title"] = "Dinamo Zagreb - Coaches";
    ViewData["ActivePage"] = "Coach";
    ViewData["Breadcrumbs"] = new List<(string, string?)>
    {
        ("Dashboard", "/"),
        ("Coaches", null)
    };
    var currentDate = DateTime.Now;
    var currentCoach = Model.FirstOrDefault(c => c.ContractUntil > currentDate);
    var pastCoaches = Model.Where(c => c.ContractUntil <= currentDate).OrderByDescending(c => c.ContractUntil).ToList();
}

<div class="page-header">
    <h2>Dinamo Zagreb - Coaches</h2>
    <p>Current and past coaching staff</p>
</div>

@if (currentCoach != null)
{
    <div class="card">
        <div class="card-header">
            <h3>Current Head Coach</h3>
            <span class="badge badge-green">Active</span>
        </div>
        <div class="card-body">
            <div class="profile-card">
                <div class="profile-header">
                    <h2 style="margin: 0 0 10px 0;">@currentCoach.FirstName @currentCoach.LastName</h2>
                    <span class="badge badge-green" style="font-size: 12px;">Current</span>
                </div>
                <div class="info-row">
                    <div class="info-label">Nationality</div>
                    <div class="info-value">@currentCoach.Nationality</div>
                </div>
                <div class="info-row">
                    <div class="info-label">Date of Birth</div>
                    <div class="info-value">@currentCoach.DateOfBirth.ToString("dd.MM.yyyy")</div>
                </div>
                <div class="info-row">
                    <div class="info-label">Contract Until</div>
                    <div class="info-value">@currentCoach.ContractUntil.ToString("dd.MM.yyyy")</div>
                </div>
                <div class="info-row" style="margin-top: 15px;">
                    <a href="/Coach/@currentCoach.Id" class="view-link">View Full Profile →</a>
                </div>
            </div>
        </div>
    </div>
}

@if (pastCoaches.Any())
{
    <div class="card">
        <div class="card-header">
            <h3>Past Coaches</h3>
            <span class="badge badge-gray">@pastCoaches.Count</span>
        </div>
        <div class="card-body">
            <table class="fc-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Nationality</th>
                        <th>Date of Birth</th>
                        <th>Contract Ended</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var coach in pastCoaches)
                    {
                        <tr>
                            <td><strong>@coach.FirstName @coach.LastName</strong></td>
                            <td>@coach.Nationality</td>
                            <td>@coach.DateOfBirth.ToString("dd.MM.yyyy")</td>
                            <td>@coach.ContractUntil.ToString("dd.MM.yyyy")</td>
                            <td><a href="/Coach/@coach.Id" class="view-link">View →</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (!Model.Any())
{
    <div class="card" style="text-align: center; padding: 40px;">
        <p style="color: var(--text-muted);">No coaches found</p>
    </div>
}
