@{
    ViewData["Title"] = "Dashboard";
    ViewData["ActivePage"] = "Home";
    ViewData["Breadcrumbs"] = new List<(string, string?)>
    {
        ("Dashboard", null)
    };
}

<div class="page-header">
    <h2>Dinamo Zagreb</h2>
    <p>Official Management Dashboard</p>
</div>

<!-- Stat Cards -->
<div class="stat-grid">
    <div class="stat-card">
        <div class="stat-label">Squad Size</div>
        <div class="stat-value">@ViewBag.TotalPlayers</div>
        <div class="stat-sub">players in squad</div>
    </div>
    
    <div class="stat-card accent-blue">
        <div class="stat-label">Upcoming Matches</div>
        <div class="stat-value">@ViewBag.UpcomingMatches</div>
        <div class="stat-sub">scheduled</div>
    </div>
    
    <div class="stat-card accent-amber">
        <div class="stat-label">Injured Players</div>
        <div class="stat-value">@ViewBag.InjuredPlayers.Count</div>
        <div class="stat-sub">currently out</div>
    </div>
    
    <div class="stat-card accent-green">
        <div class="stat-label">Club Name</div>
        <div class="stat-value" style="font-size: 16px; padding-top: 4px;">@ViewBag.DinamoClub?.Name</div>
        <div class="stat-sub">@ViewBag.DinamoClub?.City</div>
    </div>
</div>

<!-- Top Scorer -->
@if (ViewBag.TopScorer != null)
{
    Player topScorer = ViewBag.TopScorer;
    <div class="card">
        <div class="card-header">
            <h3>🏆 Top Scorer</h3>
        </div>
        <div class="card-body">
            <div style="display: flex; align-items: center; gap: 1.5rem;">
                <div style="width: 64px; height: 64px; background: var(--blue); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: 700; color: var(--text-main);">
                    @topScorer.FirstName.Substring(0, 1)@topScorer.LastName.Substring(0, 1)
                </div>
                <div>
                    <div style="font-size: 16px; font-weight: 700; color: var(--text-dark);">
                        <a href="/Player/@topScorer.Id" style="color: var(--text-dark); text-decoration: none;">@topScorer.FirstName @topScorer.LastName</a>
                    </div>
                    <div style="font-size: 13px; color: var(--text-muted);">@topScorer.Club?.Name</div>
                    <div style="margin-top: 8px;">
                        <span style="font-size: 18px; font-weight: 800; color: var(--blue);">@topScorer.Stats.Sum(s => s.Goals)</span>
                        <span style="color: var(--text-muted); margin-left: 8px;">goals</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<!-- Upcoming Match -->
@if (ViewBag.UpcomingMatch != null)
{
    <div class="upcoming-card">
        <div class="upcoming-label">► Upcoming Match</div>
        <div class="match-teams">
            <div class="team">
                <div style="font-size: 14px; color: var(--text-muted);">HOME</div>
                <div style="font-size: 16px; font-weight: 700;">@ViewBag.UpcomingMatch.HomeClub.Name</div>
            </div>
            <div class="vs">VS</div>
            <div class="team">
                <div style="font-size: 14px; color: var(--text-muted);">AWAY</div>
                <div style="font-size: 16px; font-weight: 700;">@ViewBag.UpcomingMatch.AwayClub.Name</div>
            </div>
        </div>
        <div class="match-meta">
            <span>📅 @ViewBag.UpcomingMatch.Date.ToString("dd.MM.yyyy HH:mm")</span>
            <span>📍 @ViewBag.UpcomingMatch.Stadium?.Name</span>
            <span>🎯 @ViewBag.UpcomingMatch.Round</span>
        </div>
        <div style="margin-top: 1rem;">
            <a href="/Match/@ViewBag.UpcomingMatch.Id" style="color: var(--blue-light); text-decoration: none; font-weight: 700;">View Match Details →</a>
        </div>
    </div>
}

<!-- Recent Matches -->
@if (ViewBag.RecentMatches != null && ViewBag.RecentMatches.Count > 0)
{
    <div class="card">
        <div class="card-header">
            <h3>Recent Matches</h3>
        </div>
        <div class="card-body">
            <table class="fc-table">
                <thead>
                    <tr>
                        <th>Match</th>
                        <th>Result</th>
                        <th>Date</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var match in ViewBag.RecentMatches)
                    {
                        <tr>
                            <td>
                                <strong>@match.HomeClub.Name</strong> vs <strong>@match.AwayClub.Name</strong>
                            </td>
                            <td style="font-weight: 700;">@match.HomeScore - @match.AwayScore</td>
                            <td>@match.Date.ToString("dd.MM.yyyy")</td>
                            <td><a href="/Match/@match.Id" class="view-link">Details →</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- Injured Players -->
@if (ViewBag.InjuredPlayers != null && ViewBag.InjuredPlayers.Count > 0)
{
    <div class="card">
        <div class="card-header">
            <h3>⚠️ Injured Players</h3>
        </div>
        <div class="card-body">
            <table class="fc-table">
                <thead>
                    <tr>
                        <th>Player</th>
                        <th>Position</th>
                        <th>Club</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var player in ViewBag.InjuredPlayers)
                    {
                        <tr>
                            <td><strong>@player.FirstName @player.LastName</strong></td>
                            <td><span class="badge badge-red">@player.Position</span></td>
                            <td>@player.Club?.Name</td>
                            <td><a href="/Player/@player.Id" class="view-link">Profile →</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
