@using FootballClub.Models.Enums 
@model List<Player>

@{
    ViewData["Title"] = "Players";
    ViewData["ActivePage"] = "Player";
    Club selectedClub = ViewBag.SelectedClub; PlayerPosition? selectedPosition = ViewBag.SelectedPosition;
    
    ViewData["Breadcrumbs"] = new List<(string, string?)>
    {
        ("Dashboard", "/"),
        ("Players", null)
    };
}

<div class="page-header">
    <h2>Players</h2>
    <p>@(selectedClub != null ? $"Manage {selectedClub.Name} squad and responsibilities" : "Manage player operations across clubs")</p>
</div>

<div class="card">
    <div class="card-header">
        <h3>Player Roster</h3>
        <div style="display: flex; gap: 8px;">
            <span class="badge badge-blue">@(selectedClub?.Name ?? "Club")</span>
            @if (selectedClub != null)
            {
                <a href="/Player/Schedule?clubId=@selectedClub.Id" class="view-link">Weekly Schedules →</a>
            }
        </div>
    </div>
    <div class="card-body">
        <form id="clubFilterForm" method="get" action="/Player" style="display: flex; gap: 10px; align-items: center; margin-bottom: 16px; flex-wrap: wrap;">
            <label for="posFilter" style="font-weight: 700; color: var(--text-dark);">Select Position:</label>
            <select id="posFilter" name="position" onchange="document.getElementById('clubFilterForm').submit();" style="padding: 8px 12px; border-radius: 6px; border: 1px solid var(--dark-border); background: var(--dark-card); color: var(--text-main); min-width: 260px; font-size: 14px;">
                <option value="">All Positions</option>
                @foreach (PlayerPosition pos in Enum.GetValues(typeof(PlayerPosition)))
                {
                    if (selectedPosition == pos)
                    {
                        <option value="@pos" selected>@pos.ToString()</option>
                    }
                    else
                    {
                        <option value="@pos">@pos.ToString()</option>
                    }
                }
            </select>
            <button type="submit" class="btn-back" style="padding: 8px 14px;">Apply</button>
        </form>

        <div style="margin-bottom: 18px;">
            @await Html.PartialAsync("_AutocompleteDropdown", null, new ViewDataDictionary(ViewData)
            {
                ["Label"] = "Find a player",
                ["Placeholder"] = "Search by player name...",
                ["Endpoint"] = "/api/players/search",
                ["MinChars"] = 2,
                ["FieldName"] = "playerSearch"
            })
        </div>

        <div style="margin-bottom:12px; display:flex; gap:8px; align-items:center;">
            <input id="playerQuickSearch" type="search" placeholder="Quick search players..." class="form-control" style="max-width:420px;" />
            <button id="clearPlayerSearch" class="btn btn-outline-light" type="button">Clear</button>
            <a class="btn btn-primary" href="/Player/Create">Add player</a>
        </div>

        <table class="fc-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Position</th>
                    <th>Club</th>
                    <th>Jersey</th>
                    <th>Market Value</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="playersTableBody">
                @await Html.PartialAsync("_PlayerRows", Model)
            </tbody>
        </table>
    </div>
</div>

<script>
    (function(){
        var input = document.getElementById('playerQuickSearch');
        var clearBtn = document.getElementById('clearPlayerSearch');
        var timeout = null;
        var tbody = document.getElementById('playersTableBody');

        function fetchAndRender(q) {
            fetch('/Player/Filter?term=' + encodeURIComponent(q), { headers: { 'Accept': 'text/html' } })
                .then(function(r){ return r.text(); })
                .then(function(html){ 
                    tbody.innerHTML = html; 
                    // Reinitialize row hover animations after AJAX update
                    if (window.reinitializeAnimations) {
                        window.reinitializeAnimations();
                    }
                })
                .catch(function(){});
        }

        input.addEventListener('input', function(){
            clearTimeout(timeout);
            timeout = setTimeout(function(){ fetchAndRender(input.value.trim()); }, 250);
        });

        clearBtn.addEventListener('click', function(){ input.value = ''; fetchAndRender(''); input.focus(); });
    })();
</script>


