@using FootballClub.Models.Enums
@model Player

@{
    ViewData["Title"] = $"{Model.FirstName} {Model.LastName}";
    ViewData["ActivePage"] = "Player";
    ViewData["Breadcrumbs"] = new List<(string, string?)>
    {
        ("Dashboard", "/"),
        ("Players", "/Player"),
        ($"{Model.FirstName} {Model.LastName}", null)
    };
}

<style>
    .sofa-container {
        font-family: Arial, sans-serif;
        background-color: #12141c;
        color: #fff;
        padding: 20px;
        border-radius: 8px;
        min-height: 800px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }
    .sofa-header {
        display: flex;
        background-color: #1a1e29;
        padding: 20px;
        border-radius: 8px;
        align-items: center;
        gap: 20px;
    }
    .sofa-avatar {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background-color: #fff;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 24px;
        color: #12141c;
        font-weight: bold;
    }
    .sofa-name-info h1 {
        margin: 0 0 5px 0;
        font-size: 24px;
        color: #fff;
    }
    .sofa-name-info h3 {
        margin: 0 0 10px 0;
        font-size: 16px;
        color: #afb2b8;
    }
    .sofa-stats-row {
        display: flex;
        gap: 15px;
        font-size: 14px;
        color: #afb2b8;
    }
    .sofa-grid {
        display: grid;
        grid-template-columns: 300px 1fr;
        gap: 16px;
    }
    .sofa-panel {
        background-color: #1a1e29;
        padding: 20px;
        border-radius: 8px;
    }
    .sofa-panel h4 {
        margin-top: 0;
        color: #fff;
        font-size: 16px;
        border-bottom: 1px solid #2a2e39;
        padding-bottom: 10px;
        margin-bottom: 15px;
    }
    .sofa-value {
        font-size: 24px;
        color: #eab308;
        font-weight: bold;
    }
    .sofa-matches-table {
        width: 100%;
        border-collapse: collapse;
        color: #fff;
    }
    .sofa-matches-table th, .sofa-matches-table td {
        padding: 10px;
        text-align: left;
        border-bottom: 1px solid #2a2e39;
        font-size: 14px;
    }
    .sofa-matches-table th {
        color: #afb2b8;
        font-weight: normal;
    }
    .badge-rating {
        background-color: #16a34a;
        color: white;
        padding: 4px 8px;
        border-radius: 4px;
        font-weight: bold;
    }

    @@media (max-width: 900px) {
        .sofa-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 640px) {
        .sofa-container {
            padding: 12px;
            min-height: 0;
        }

        .sofa-header {
            flex-wrap: wrap;
            padding: 16px;
        }

            /* action buttons drop to their own full-width row when wrapped */
            .sofa-header > div:last-child {
                margin-left: 0 !important;
                width: 100%;
            }

        .sofa-stats-row {
            flex-wrap: wrap;
            row-gap: 6px;
        }
    }
</style>

<div class="sofa-container">
    <div class="sofa-header">
        <div class="sofa-avatar">
            @Model.FirstName[0]@Model.LastName[0]
        </div>
        <div class="sofa-name-info">
            <h1>@Model.FirstName @Model.LastName</h1>
            <h3>@Model.Club?.Name</h3>
            <div class="sofa-stats-row">
                <span>🇭🇷 @Model.Nationality</span>
                <span>🎂 @Model.DateOfBirth.ToString("dd MMM yyyy")</span>
                <span>⚽ @Model.Position</span>
                <span>👕 Number @Model.JerseyNumber</span>
            </div>
        </div>
        <div style="margin-left:auto; display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
            <a href="/Player/Edit/@Model.Id" class="btn btn-sm btn-primary">Edit Player</a>
            <form method="post" action="/Player/Delete/@Model.Id" style="display:inline;" onsubmit="return confirm('Soft delete this player?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-danger">Delete Player</button>
            </form>
            <a href="/Player" class="btn btn-sm btn-ghost btn-arrow-left">Back to Players</a>
        </div>
    </div>

    <div class="sofa-grid">
        <div class="sofa-left-col">
            <div class="sofa-panel" style="margin-bottom: 16px;">
                <h4>Player value</h4>
                <div class="sofa-value">€@Model.MarketValue.ToString("F1") M</div>
            </div>
            
            <div class="sofa-panel">
                <h4>Attribute Overview</h4>
                <div style="text-align: center; padding: 20px; color: #afb2b8;">
                    <!-- Placeholder for radar chart -->
                    <svg width="150" height="150" viewBox="0 0 100 100">
                        <polygon points="50,10 90,40 75,90 25,90 10,40" fill="#16a34a" fill-opacity="0.2" stroke="#16a34a" stroke-width="2"/>
                    </svg>
                </div>
            </div>
        </div>

        <div class="sofa-right-col">
            <div class="sofa-panel">
                <h4>Matches</h4>
                <table class="sofa-matches-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Opponent</th>
                            <th>Result</th>
                            <th>Rating</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>18.04.2026</td>
                            <td>HNK Rijeka</td>
                            <td><span style="color: #eab308">D</span> 2 - 2</td>
                            <td><span class="badge-rating" style="background-color: #eab308">6.6</span></td>
                        </tr>
                        <tr>
                            <td>14.03.2026</td>
                            <td>NK Slaven Belupo</td>
                            <td><span style="color: #16a34a">W</span> 4 - 2</td>
                            <td><span class="badge-rating">7.3</span></td>
                        </tr>
                        <tr>
                            <td>08.03.2026</td>
                            <td>HNK Hajduk Split</td>
                            <td><span style="color: #16a34a">W</span> 3 - 1</td>
                            <td><span class="badge-rating">7.6</span></td>
                        </tr>
                        <tr>
                            <td>01.03.2026</td>
                            <td>HNK Gorica</td>
                            <td><span style="color: #16a34a">W</span> 4 - 2</td>
                            <td><span class="badge-rating">6.8</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- File Upload Component -->
<div style="margin-top: 2rem;">
    @{
        ViewBag.EntityType = "Player";
        ViewBag.EntityId = Model.Id;
    }
    @await Html.PartialAsync("_AttachmentUpload")
</div>

