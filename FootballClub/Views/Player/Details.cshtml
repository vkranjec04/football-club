@using FootballClub.Models.Enums
@model Player
@{
    var weeklySchedule = (ViewBag.WeeklySchedule as List<PlayerScheduleItem> ?? new List<PlayerScheduleItem>())
        .OrderBy(item => item.StartTime)
        .ToList();
}

@{
    ViewData["Title"] = $"{Model.FirstName} {Model.LastName}";
    ViewData["ActivePage"] = "Player";
    ViewData["Breadcrumbs"] = new List<(string, string?)>
    {
        ("Dashboard", "/"),
        ("Players", "/team-roster"),
        ($"{Model.FirstName} {Model.LastName}", null)
    };
}

<style>
    .sofa-container {
        font-family: Arial, sans-serif;
        background-color: #12141c;
        color: #fff;
        padding: 20px;
        border-radius: 8px;
        min-height: 800px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }
    .sofa-header {
        display: flex;
        background-color: #1a1e29;
        padding: 20px;
        border-radius: 8px;
        align-items: center;
        gap: 20px;
    }
    .sofa-avatar {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background-color: #fff;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 24px;
        color: #12141c;
        font-weight: bold;
    }
    .sofa-name-info h1 {
        margin: 0 0 5px 0;
        font-size: 24px;
        color: #fff;
    }
    .sofa-name-info h3 {
        margin: 0 0 10px 0;
        font-size: 16px;
        color: #afb2b8;
    }
    .sofa-stats-row {
        display: flex;
        gap: 15px;
        font-size: 14px;
        color: #afb2b8;
    }
    .sofa-grid {
        display: grid;
        grid-template-columns: 300px 1fr;
        gap: 16px;
    }
    .sofa-panel {
        background-color: #1a1e29;
        padding: 20px;
        border-radius: 8px;
    }
    .sofa-panel h4 {
        margin-top: 0;
        color: #fff;
        font-size: 16px;
        border-bottom: 1px solid #2a2e39;
        padding-bottom: 10px;
        margin-bottom: 15px;
    }
    .sofa-value {
        font-size: 24px;
        color: #eab308;
        font-weight: bold;
    }
    .sofa-matches-table {
        width: 100%;
        border-collapse: collapse;
        color: #fff;
    }
    .sofa-matches-table th, .sofa-matches-table td {
        padding: 10px;
        text-align: left;
        border-bottom: 1px solid #2a2e39;
        font-size: 14px;
    }
    .sofa-matches-table th {
        color: #afb2b8;
        font-weight: normal;
    }
    .badge-rating {
        background-color: #16a34a;
        color: white;
        padding: 4px 8px;
        border-radius: 4px;
        font-weight: bold;
    }

    @@media (max-width: 900px) {
        .sofa-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 640px) {
        .sofa-container {
            padding: 12px;
            min-height: 0;
        }

        .sofa-header {
            flex-wrap: wrap;
            padding: 16px;
        }

            /* action buttons drop to their own full-width row when wrapped */
            .sofa-header > div:last-child {
                margin-left: 0 !important;
                width: 100%;
            }

        .sofa-stats-row {
            flex-wrap: wrap;
            row-gap: 6px;
        }
    }
</style>

<div class="sofa-container">
    <div class="sofa-header">
        <div class="sofa-avatar">
            @Model.FirstName[0]@Model.LastName[0]
        </div>
        <div class="sofa-name-info">
            <h1>@Model.FirstName @Model.LastName</h1>
            <h3>@Model.Club?.Name</h3>
            <div class="sofa-stats-row">
                <span>🇭🇷 @Model.Nationality</span>
                <span>🎂 @Model.DateOfBirth.ToString("dd MMM yyyy")</span>
                <span>⚽ @Model.Position</span>
                <span>👕 Number @Model.JerseyNumber</span>
            </div>
        </div>
        <div style="margin-left:auto; display:flex; gap:8px; align-items:center; flex-wrap:wrap;">
            <a href="/Player/Edit/@Model.Id" class="btn btn-sm btn-primary">Edit Player</a>
            <form method="post" action="/Player/Delete/@Model.Id" style="display:inline;" onsubmit="return confirm('Soft delete this player?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-danger">Delete Player</button>
            </form>
            <a href="/team-roster" class="btn btn-sm btn-ghost btn-arrow-left">Back to Players</a>
        </div>
    </div>

    <div class="sofa-grid">
        <div class="sofa-left-col">
            <div class="sofa-panel" style="margin-bottom: 16px;">
                <h4>Player value</h4>
                <div class="sofa-value">€@Model.MarketValue.ToString("F1") M</div>
            </div>
            
            <div class="sofa-panel">
                <h4>Attribute Overview</h4>
                @{
                    var overview = ViewBag.AttributeOverview as PlayerAttributeOverview ?? new PlayerAttributeOverview();
                    var axes = new (string Label, int Value)[]
                    {
                        ("ATT", overview.Attacking),
                        ("TEC", overview.Technical),
                        ("TAC", overview.Tackling),
                        ("DEF", overview.Defending),
                        ("CRE", overview.Creativity),
                    };
                    const double cx = 100, cy = 100, maxR = 72;

                    (double X, double Y) PointAt(int index, double radius)
                    {
                        var angle = (-90 + index * 72) * Math.PI / 180.0;
                        return (cx + radius * Math.Cos(angle), cy + radius * Math.Sin(angle));
                    }

                    // SVG attributes use commas/periods as syntax, so coordinates must always be
                    // formatted with an invariant decimal point regardless of request culture
                    // (this app's default locale is "hr", where :F1 would render "100,0" — which
                    // the SVG parser reads as two separate numbers, wrecking the whole shape).
                    string F(double value) => value.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);

                    var valuePoints = string.Join(" ", axes.Select((a, i) =>
                    {
                        var p = PointAt(i, maxR * (a.Value / 100.0));
                        return $"{F(p.X)},{F(p.Y)}";
                    }));
                    var outlinePoints = string.Join(" ", axes.Select((a, i) =>
                    {
                        var p = PointAt(i, maxR);
                        return $"{F(p.X)},{F(p.Y)}";
                    }));
                    var midPoints = string.Join(" ", Enumerable.Range(0, 5).Select(i =>
                    {
                        var p = PointAt(i, maxR * 0.5);
                        return $"{F(p.X)},{F(p.Y)}";
                    }));
                }
                <div style="text-align: center; padding: 8px;">
                    <svg width="200" height="200" viewBox="0 0 200 200">
                        <polygon points="@outlinePoints" fill="none" stroke="#334155" stroke-width="1" />
                        <polygon points="@midPoints" fill="none" stroke="#2a2e39" stroke-width="1" />
                        <polygon points="@valuePoints" fill="#16a34a" fill-opacity="0.35" stroke="#16a34a" stroke-width="2" />
                        @for (int i = 0; i < axes.Length; i++)
                        {
                            var labelPos = PointAt(i, maxR + 20);
                            @Html.Raw($"<text x=\"{F(labelPos.X)}\" y=\"{F(labelPos.Y)}\" font-size=\"11\" fill=\"#afb2b8\" text-anchor=\"middle\">{axes[i].Label}</text>")
                            @Html.Raw($"<text x=\"{F(labelPos.X)}\" y=\"{F(labelPos.Y + 13)}\" font-size=\"12\" font-weight=\"bold\" fill=\"#eab308\" text-anchor=\"middle\">{axes[i].Value}</text>")
                        }
                    </svg>
                </div>
            </div>
        </div>

        <div class="sofa-right-col">
            <div class="sofa-panel">
                <h4>Matches</h4>
                <table class="sofa-matches-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Opponent</th>
                            <th>Result</th>
                            <th>Rating</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>18.04.2026</td>
                            <td>HNK Rijeka</td>
                            <td><span style="color: #eab308">D</span> 2 - 2</td>
                            <td><span class="badge-rating" style="background-color: #eab308">6.6</span></td>
                        </tr>
                        <tr>
                            <td>14.03.2026</td>
                            <td>NK Slaven Belupo</td>
                            <td><span style="color: #16a34a">W</span> 4 - 2</td>
                            <td><span class="badge-rating">7.3</span></td>
                        </tr>
                        <tr>
                            <td>08.03.2026</td>
                            <td>HNK Hajduk Split</td>
                            <td><span style="color: #16a34a">W</span> 3 - 1</td>
                            <td><span class="badge-rating">7.6</span></td>
                        </tr>
                        <tr>
                            <td>01.03.2026</td>
                            <td>HNK Gorica</td>
                            <td><span style="color: #16a34a">W</span> 4 - 2</td>
                            <td><span class="badge-rating">6.8</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="sofa-panel" style="margin-top: 16px;">
        <h4>Weekly Training &amp; Obligations</h4>
        @if (weeklySchedule.Count == 0)
        {
            <p style="color: #afb2b8; margin: 0;">No training sessions or obligations scheduled for @Model.FirstName this week.</p>
        }
        else
        {
            <table class="fc-table">
                <thead>
                    <tr>
                        <th>Date &amp; Time</th>
                        <th>Task</th>
                        <th>Type</th>
                        <th>Location</th>
                        <th>Assigned By</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var task in weeklySchedule)
                    {
                        var typeClass = task.ResponsibilityType switch
                        {
                            ScheduleResponsibilityType.RegularTraining => "badge-blue",
                            ScheduleResponsibilityType.Gym => "badge-amber",
                            ScheduleResponsibilityType.PhysicalTherapy => "badge-green",
                            ScheduleResponsibilityType.Massage => "badge-green",
                            ScheduleResponsibilityType.MediaTraining => "badge-red",
                            _ => "badge-gray"
                        };
                        <tr>
                            <td data-label="Date & Time">@task.StartTime.ToString("ddd, dd.MM HH:mm") - @task.EndTime.ToString("HH:mm")</td>
                            <td data-label="Task">
                                <strong>@task.Title</strong>
                                <div style="color: #afb2b8; font-size: 12px;">@task.Notes</div>
                            </td>
                            <td data-label="Type"><span class="badge @typeClass">@task.ResponsibilityType</span></td>
                            <td data-label="Location">@task.Location</td>
                            <td data-label="Assigned By">@task.AssignedBy</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

