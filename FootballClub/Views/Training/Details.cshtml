@model FootballClub.Models.TrainingSession

@{
    ViewData["Title"] = Model.Title;
    ViewData["ActivePage"] = "Training";
}

<a href="/Training" class="btn-back btn-arrow-left">Back to Training</a>

<div class="page-header">
    <h2>@Model.Title</h2>
    <p>@Model.StartTime.ToString("dddd, dd.MM.yyyy HH:mm") &bull; @Model.Location</p>
</div>

<div class="card" style="margin-bottom: 16px;">
    <div class="card-body" style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
        @if (Model.IsDeleted)
        {
            <span class="badge" style="background-color: #dc2626;">Deleted</span>
            <form method="post" action="/Training/Restore/@Model.Id" style="display: inline; margin: 0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-success">Restore</button>
            </form>
        }
        else
        {
            <a href="/Training/Edit/@Model.Id" class="btn btn-sm btn-ghost btn-arrow">Edit</a>
            <form method="post" action="/Training/Delete/@Model.Id" style="display: inline; margin: 0;" onsubmit="return confirm('Soft delete this training session?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
            </form>
        }
    </div>
</div>

<div class="detail-grid" style="grid-template-columns: 1fr;">
    <div class="card">
        <div class="card-header">
            <h3>Session Overview</h3>
            <span class="badge badge-blue">@Model.Intensity</span>
        </div>
        <div class="card-body">
            <div class="info-row">
                <span class="lbl">Club</span>
                <span class="val">@Model.Club.Name</span>
            </div>
            <div class="info-row">
                <span class="lbl">Focus Area</span>
                <span class="val">@Model.FocusArea</span>
            </div>
            <div class="info-row">
                <span class="lbl">Start</span>
                <span class="val">@Model.StartTime.ToString("dd.MM.yyyy HH:mm")</span>
            </div>
            <div class="info-row">
                <span class="lbl">End</span>
                <span class="val">@Model.EndTime.ToString("dd.MM.yyyy HH:mm")</span>
            </div>
            <div class="info-row">
                <span class="lbl">Duration</span>
                <span class="val">@((Model.EndTime - Model.StartTime).TotalMinutes) minutes</span>
            </div>
            <div class="info-row">
                <span class="lbl">Lead Staff</span>
                <span class="val">
                    @if (Model.LeadStaff != null)
                    {
                        <a href="/staff-members/@Model.LeadStaff.Id" class="btn btn-sm btn-ghost">@Model.LeadStaff.FirstName @Model.LeadStaff.LastName</a>
                    }
                    else
                    {
                        <text>Coaching Staff</text>
                    }
                </span>
            </div>
            <div class="info-row">
                <span class="lbl">Plan Notes</span>
                <span class="val">@Model.Notes</span>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3>Participant List</h3>
            <span class="badge badge-green">@Model.Participants.Count players</span>
        </div>
        <div class="card-body">
            @if (Model.Participants.Count == 0)
            {
                <p style="color: var(--text-muted);">No players assigned.</p>
            }
            else
            {
                <table class="fc-table">
                    <thead>
                        <tr>
                            <th>Player</th>
                            <th>Position</th>
                            <th>Jersey</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var player in Model.Participants.OrderBy(p => p.Position).ThenBy(p => p.LastName))
                        {
                            <tr>
                                <td><strong>@player.FullName</strong></td>
                                <td>@player.Position</td>
                                <td>#@player.JerseyNumber</td>
                                <td>
                                    @if (player.IsInjured)
                                    {
                                        <span class="badge badge-red">Limited</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-green">Available</span>
                                    }
                                </td>
                                <td><a href="/player-profile/@player.Id" class="btn btn-sm btn-ghost btn-arrow">Profile</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
