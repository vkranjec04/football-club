@using FootballClub.Models
@model IEnumerable<TrainingSession>

@{
    var isAdmin = ViewBag.IsAdmin ?? false;
}

@foreach (var session in Model.OrderBy(s => s.IsDeleted ? 1 : 0).ThenBy(s => s.StartTime))
{
    if (!session.IsDeleted || isAdmin)
    {
        var statusClass = session.IsDeleted ? "style='opacity: 0.5;'" : "";
        <tr @Html.Raw(statusClass)>
            <td>
                <strong>@session.Title</strong>
                <div style="color: var(--text-muted); font-size: 12px;">@session.FocusArea</div>
            </td>
            <td>@session.StartTime.ToString("ddd, dd.MM.yyyy HH:mm")</td>
            <td>@((session.EndTime - session.StartTime).TotalMinutes) min</td>
            <td><span class="badge badge-gray">@session.Intensity</span></td>
            <td>@session.Participants.Count</td>
            <td>
                @if (session.IsDeleted)
                {
                    <span class="badge" style="background-color: #dc2626;">Deleted</span>
                }
                else
                {
                    <span class="badge badge-blue">@(session.IsUpcoming ? "Upcoming" : "Past")</span>
                }
            </td>
            <td class="td-actions">
                @if (session.IsDeleted && isAdmin)
                {
                    <form method="post" action="/Training/Restore/@session.Id" style="display: inline; margin: 0;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-success">Restore</button>
                    </form>
                }
                else
                {
                    <a href="/Training/Details/@session.Id" class="btn btn-sm btn-ghost btn-arrow">Details</a>
                    <a href="/Training/Edit/@session.Id" class="btn btn-sm btn-ghost btn-arrow">Edit</a>
                    <form method="post" action="/Training/Delete/@session.Id" style="display: inline; margin: 0;" onsubmit="return confirm('Soft delete this training session?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                }
            </td>
        </tr>
    }
}
