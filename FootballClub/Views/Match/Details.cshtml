@using FootballClub.Models.Enums
@model Match

@{
    ViewData["Title"] = $"{Model.HomeClub.Name} vs {Model.AwayClub.Name} - Match Details";
    ViewData["ActivePage"] = "Match";
    ViewData["Breadcrumbs"] = new List<(string, string?)>
    {
        ("Dashboard", "/"),
        ("Matches", "/Match"),
        ($"{Model.HomeClub.Name} vs {Model.AwayClub.Name}", null)
    };
}

<a href="/Match" class="btn-back">← Back to Matches</a>

<div class="page-header">
    <h2>@Model.HomeClub.Name vs @Model.AwayClub.Name</h2>
    <p>@Model.Round - @Model.Date.ToString("dddd, dd.MM.yyyy HH:mm")</p>
</div>

<!-- Score Display (only for finished matches) -->
@if (Model.Status == MatchStatus.Finished)
{
    <div class="score-display">
        <div class="score-team">
            <div class="score-team-name">Home</div>
            <div class="score-team-club">@Model.HomeClub.Name</div>
        </div>
        <div class="score-result">@Model.HomeScore - @Model.AwayScore</div>
        <div class="score-team">
            <div class="score-team-name">Away</div>
            <div class="score-team-club">@Model.AwayClub.Name</div>
        </div>
    </div>
}

<div class="detail-grid" style="grid-template-columns: 1fr;">
    <!-- Match Information -->
    <div class="card">
        <div class="card-header">
            <h3>Match Information</h3>
        </div>
        <div class="card-body">
            <div class="info-row">
                <span class="lbl">Round</span>
                <span class="val">@Model.Round</span>
            </div>
            <div class="info-row">
                <span class="lbl">Date & Time</span>
                <span class="val">@Model.Date.ToString("dddd, dd.MM.yyyy HH:mm")</span>
            </div>
            <div class="info-row">
                <span class="lbl">Status</span>
                <span class="val">
                    @if (Model.Status == MatchStatus.Finished)
                    {
                        <span class="badge badge-green">Finished</span>
                    }
                    else
                    {
                        <span class="badge badge-blue">Scheduled</span>
                    }
                </span>
            </div>
            <div class="info-row">
                <span class="lbl">Stadium</span>
                <span class="val">
                    @if (Model.Stadium != null)
                    {
                        <text>@Model.Stadium.Name (@Model.Stadium.City)</text>
                    }
                </span>
            </div>
            <div class="info-row">
                <span class="lbl">Referee</span>
                <span class="val">@Model.Referee</span>
            </div>
            @if (Model.Status == MatchStatus.Finished)
            {
                <div class="info-row">
                    <span class="lbl">Attendance</span>
                    <span class="val">@Model.Attendance.ToString("N0")</span>
                </div>
                <div class="info-row">
                    <span class="lbl">Result</span>
                    <span class="val" style="font-size: 18px; font-weight: 800;">@Model.HomeScore - @Model.AwayScore</span>
                </div>
            }
        </div>
    </div>

    <!-- Home Team -->
    <div class="card">
        <div class="card-header">
            <h3>Home Team: @Model.HomeClub.Name</h3>
        </div>
        <div class="card-body">
            <div class="info-row">
                <span class="lbl">Club</span>
                <span class="val"><a href="/Club/@Model.HomeClub.Id" class="view-link">@Model.HomeClub.Name</a></span>
            </div>
            <div class="info-row">
                <span class="lbl">City</span>
                <span class="val">@Model.HomeClub.City</span>
            </div>
            <div class="info-row">
                <span class="lbl">Budget</span>
                <span class="val">€@Model.HomeClub.Budget.ToString("F1")M</span>
            </div>
            @if (Model.Status == MatchStatus.Finished)
            {
                <div class="info-row">
                    <span class="lbl">Score</span>
                    <span class="val" style="font-size: 18px; font-weight: 800;">@Model.HomeScore</span>
                </div>
            }
        </div>
    </div>

    <!-- Away Team -->
    <div class="card">
        <div class="card-header">
            <h3>Away Team: @Model.AwayClub.Name</h3>
        </div>
        <div class="card-body">
            <div class="info-row">
                <span class="lbl">Club</span>
                <span class="val"><a href="/Club/@Model.AwayClub.Id" class="view-link">@Model.AwayClub.Name</a></span>
            </div>
            <div class="info-row">
                <span class="lbl">City</span>
                <span class="val">@Model.AwayClub.City</span>
            </div>
            <div class="info-row">
                <span class="lbl">Budget</span>
                <span class="val">€@Model.AwayClub.Budget.ToString("F1")M</span>
            </div>
            @if (Model.Status == MatchStatus.Finished)
            {
                <div class="info-row">
                    <span class="lbl">Score</span>
                    <span class="val" style="font-size: 18px; font-weight: 800;">@Model.AwayScore</span>
                </div>
            }
        </div>
    </div>

    <!-- Player Statistics (only for finished matches) -->
    @if (Model.Status == MatchStatus.Finished && Model.PlayerStats.Count > 0)
    {
        <div class="card">
            <div class="card-header">
                <h3>Player Performance (@Model.PlayerStats.Count players)</h3>
            </div>
            <div class="card-body">
                <table class="fc-table">
                    <thead>
                        <tr>
                            <th>Player</th>
                            <th>Club</th>
                            <th>Goals</th>
                            <th>Assists</th>
                            <th>Minutes</th>
                            <th>Rating</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var stat in Model.PlayerStats.OrderByDescending(s => s.Rating))
                        {
                            <tr>
                                <td><strong>@stat.Player.FirstName @stat.Player.LastName</strong></td>
                                <td>@stat.Player.Club?.Name</td>
                                <td>@stat.Goals</td>
                                <td>@stat.Assists</td>
                                <td>@stat.MinutesPlayed'</td>
                                <td style="font-weight: 700;">@stat.Rating.ToString("F1")</td>
                                <td><a href="/Player/@stat.Player.Id" class="view-link">Player →</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
