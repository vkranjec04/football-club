<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dinamo Zagreb</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- SIDEBAR -->
    <aside class="sidebar">
        <div class="sidebar-brand">
            <div class="brand-icon">⚽</div>
            <h1>Dinamo</h1>
            <p>Zagreb</p>
        </div>
        
        <nav class="sidebar-nav">
            <div class="nav-section-label">Main</div>
            <a href="/" class="nav-link @(ViewData["ActivePage"]?.ToString() == "Home" ? "active" : "")">
                <span class="nav-icon">🏠</span>
                <span>Dashboard</span>
            </a>
            
            <div class="nav-section-label">Data</div>
            <a href="/Club" class="nav-link @(ViewData["ActivePage"]?.ToString() == "Club" ? "active" : "")">
                <span class="nav-icon">🏢</span>
                <span>Clubs</span>
            </a>
            <a href="/Player" class="nav-link @(ViewData["ActivePage"]?.ToString() == "Player" ? "active" : "")">
                <span class="nav-icon">👤</span>
                <span>Players</span>
            </a>
            <a href="/Match" class="nav-link @(ViewData["ActivePage"]?.ToString() == "Match" ? "active" : "")">
                <span class="nav-icon">🏆</span>
                <span>Matches</span>
            </a>
            <a href="/Coach" class="nav-link @(ViewData["ActivePage"]?.ToString() == "Coach" ? "active" : "")">
                <span class="nav-icon">👨‍🏫</span>
                <span>Coaches</span>
            </a>
        </nav>

        <div class="sidebar-footer">
            <p>© 2026 Football Club HNL</p>
        </div>
    </aside>

    <!-- MAIN CONTENT -->
    <div class="main-content">
        <!-- TOPBAR -->
        <header class="topbar">
            <div class="breadcrumbs">
                @{
                    var breadcrumbs = ViewData["Breadcrumbs"] as List<(string label, string? url)>;
                    if (breadcrumbs != null && breadcrumbs.Count > 0)
                    {
                        for (int i = 0; i < breadcrumbs.Count; i++)
                        {
                            if (i > 0) { <span class="sep">›</span> }
                            if (breadcrumbs[i].url != null)
                            {
                                <a href="@breadcrumbs[i].url">@breadcrumbs[i].label</a>
                            }
                            else
                            {
                                <span class="current">@breadcrumbs[i].label</span>
                            }
                        }
                    }
                    else
                    {
                        <span class="current">Dashboard</span>
                    }
                }
            </div>
            <div class="topbar-right">
                Lab 2 - HNL Football
            </div>
        </header>

        <!-- PAGE BODY -->
        <div class="page-body">
            @RenderBody()
        </div>

        <!-- FOOTER -->
        <footer style="padding: 1rem 2rem; border-top: 1px solid #e2e8f0; text-align: center; font-size: 12px; color: var(--text-muted);">
            &copy; 2026 - Dinamo Zagreb Football Club | Lab 2 Assignment
        </footer>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
