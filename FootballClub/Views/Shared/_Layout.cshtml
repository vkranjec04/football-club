<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dinamo Zagreb</title>
    <link rel="icon" href="~/images/dinamo-zagreb-logo.png" type="image/png">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- SIDEBAR -->
    <aside class="sidebar" id="appSidebar">
        <div class="sidebar-brand">
            <a href="/" style="display: flex; align-items: center; gap: 12px; text-decoration: none;">
                <div class="brand-logo">
                    <img src="~/images/dinamo-zagreb-logo.png" alt="Dinamo Zagreb" style="width: 40px; height: 40px; object-fit: contain;">
                </div>
                <div>
                    <h1>Dinamo</h1>
                    <p>Zagreb</p>
                </div>
            </a>
        </div>
        
        <nav class="sidebar-nav">
            <div class="nav-section-label">Main</div>
            <a href="/" class="nav-link @(ViewData["ActivePage"]?.ToString() == "Home" ? "active" : "")">
                <span class="nav-icon">🏠</span>
                <span>Dashboard</span>
            </a>
            
            <div class="nav-section-label">Management</div>
            <a href="/team-roster" class="nav-link @(ViewData["ActivePage"]?.ToString() == "Player" ? "active" : "")">
                <span class="nav-icon">👤</span>
                <span>Players</span>
            </a>
            <a href="/Player/Schedule" class="nav-link @(ViewData["ActivePage"]?.ToString() == "Schedules" ? "active" : "")">
                <span class="nav-icon">📋</span>
                <span>Schedules</span>
            </a>
            <a href="/Training" class="nav-link @(ViewData["ActivePage"]?.ToString() == "Training" ? "active" : "")">
                <span class="nav-icon">🧪</span>
                <span>Training</span>
            </a>
            <a href="/Match" class="nav-link @(ViewData["ActivePage"]?.ToString() == "Match" ? "active" : "")">
                <span class="nav-icon">⚽</span>
                <span>Matches</span>
            </a>
            <a href="/staff-members" class="nav-link @(ViewData["ActivePage"]?.ToString() == "Staff" ? "active" : "")">
                <span class="nav-icon">👨‍🏫</span>
                <span>Staff</span>
            </a>
            <a href="/Medical" class="nav-link @(ViewData["ActivePage"]?.ToString() == "Medical" ? "active" : "")">
                <span class="nav-icon">🏥</span>
                <span>Medical Center</span>
            </a>
            <a href="/Tactics" class="nav-link @(ViewData["ActivePage"]?.ToString() == "Tactics" ? "active" : "")">
                <span class="nav-icon">📋</span>
                <span>Tactics Board</span>
            </a>

            <div class="nav-section-label admin-only" style="display:none;">Administration</div>
            <a href="/ActivityLog" class="nav-link admin-only @(ViewData["ActivePage"]?.ToString() == "ActivityLog" ? "active" : "")" style="display:none;">
                <span class="nav-icon">📜</span>
                <span>Activity Log</span>
            </a>
            <a href="/Accounts" class="nav-link admin-only @(ViewData["ActivePage"]?.ToString() == "Accounts" ? "active" : "")" style="display:none;">
                <span class="nav-icon">👥</span>
                <span>Accounts</span>
            </a>
        </nav>

        <div class="sidebar-footer">
            <p>© 2026 Club Management System</p>
        </div>
    </aside>

    <!-- MOBILE NAV BACKDROP -->
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <!-- MAIN CONTENT -->
    <div class="main-content">
        <!-- TOPBAR -->
        <header class="topbar">
            <div class="topbar-left">
                <button type="button" class="nav-toggle" id="navToggle" aria-label="Toggle navigation" aria-controls="appSidebar" aria-expanded="false">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg>
                </button>
                <div class="breadcrumbs">
                @{
                    var breadcrumbs = ViewData["Breadcrumbs"] as List<(string label, string? url)>;
                    if (breadcrumbs != null && breadcrumbs.Count > 0)
                    {
                        for (int i = 0; i < breadcrumbs.Count; i++)
                        {
                            if (i > 0) { <span class="sep">›</span> }
                            if (breadcrumbs[i].url != null)
                            {
                                <a href="@breadcrumbs[i].url">@breadcrumbs[i].label</a>
                            }
                            else
                            {
                                <span class="current">@breadcrumbs[i].label</span>
                            }
                        }
                    }
                    else
                    {
                        <span class="current">Dashboard</span>
                    }
                }
                </div>
            </div>

            @await Html.PartialAsync("_GlobalSearch")

            <div class="topbar-right">
                <span id="authStatus" style="display:none;"></span>
                <a id="authLoginLink" href="/Account/Login" class="btn btn-sm btn-ghost">Prijava</a>
                <a id="authRegisterLink" href="/Account/Register" class="btn btn-sm btn-primary">Registracija</a>
                <a id="authLogoutLink" href="#" class="btn btn-sm btn-ghost" style="display:none;">Odjava</a>
            </div>
        </header>

        <!-- PAGE BODY -->
        <div class="page-body">
            @RenderBody()
        </div>

        <!-- FOOTER -->
        <footer style="padding: 1rem 2rem; border-top: 1px solid var(--dark-border); text-align: center; font-size: 12px; color: var(--text-muted);">
            &copy; 2026 - Dinamo Zagreb Football Club
        </footer>
    </div>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/auth.js" asp-append-version="true"></script>
    <script src="~/js/global-search.js" asp-append-version="true"></script>
    <script>
        (function () {
            // Gate the whole site behind login: with no token, every page except the
            // Account auth pages (Login/Register/ExternalLogin) bounces to the login page.
            var path = window.location.pathname || '';
            var isAccountPage = /^\/Account(\/|$)/i.test(path);
            if (!Auth.getToken() && !isAccountPage) {
                var returnUrl = encodeURIComponent(window.location.pathname + window.location.search);
                window.location.replace('/Account/Login?returnUrl=' + returnUrl);
                return;
            }

            var statusLabel = document.getElementById('authStatus');
            var loginLink = document.getElementById('authLoginLink');
            var registerLink = document.getElementById('authRegisterLink');
            var logoutLink = document.getElementById('authLogoutLink');

            if (Auth.getToken()) {
                var role = Auth.getRole();
                if (statusLabel) {
                    statusLabel.textContent = (Auth.getUsername() || '') + (role ? ' (' + role + ')' : '');
                    statusLabel.style.display = '';
                }
                if (loginLink) loginLink.style.display = 'none';
                if (registerLink) registerLink.style.display = 'none';
                if (logoutLink) logoutLink.style.display = '';

                if (role === 'Admin') {
                    document.querySelectorAll('.admin-only').forEach(function (el) { el.style.display = ''; });
                }
            }

            if (logoutLink) {
                logoutLink.addEventListener('click', function (event) {
                    event.preventDefault();
                    Auth.clearSession();
                    window.location.href = '/Account/Login';
                });
            }
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
